{
  "name": "calisan-yapi-teklif",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "publish": "node scripts/publish.mjs",
    "remotion:studio": "remotion studio remotion/index.ts",
    "remotion:render:hooks": "npm run remotion:render:problem && npm run remotion:render:curiosity && npm run remotion:render:outcome",
