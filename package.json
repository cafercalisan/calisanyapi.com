    "remotion:render:curiosity": "remotion render remotion/index.ts MetaReel-Curiosity output/meta-reels/curiosity-hook.mp4 --concurrency=1",
    "remotion:render:outcome": "remotion render remotion/index.ts MetaReel-Outcome output/meta-reels/outcome-hook.mp4 --concurrency=1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.505",
    "@remotion/media": "^4.0.505",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.468.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "^4.0.505",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.2.12",
